pkgname=glide-facekey-models
pkgver=1.r1.g463cc2c
pkgrel=1
pkgdesc="Recognition models and ONNX Runtime 1.20.1 for Glide FaceKey"
arch=(x86_64)
url="https://github.com/Glide-Desktop/glide-facekey-models"
license=(custom)
depends=(glibc gcc-libs)
makedepends=(git)
options=(!strip !debug)
_git="${GLIDE_GIT:-https://github.com/Glide-Desktop}"
source=("$pkgname::git+$_git/glide-facekey-models")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    if tag="$(git describe --long --tags --abbrev=7 2>/dev/null)"; then
        printf '%s' "$tag" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf '0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    fi
}

package() {
    cd "$pkgname"
    for model in models/*.onnx; do
        install -Dm644 "$model" "$pkgdir/usr/share/glide/face/${model#models/}"
    done
    install -Dm755 lib/libonnxruntime.so.1.20.1 "$pkgdir/usr/lib/glide/face/libonnxruntime.so"
    install -Dm644 README.md "$pkgdir/usr/share/licenses/$pkgname/README.md"
}
